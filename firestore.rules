rules_version = '2';
// Etapa H2 (09/10/2026). Base: claude/site/rascunho_G/firestore.rules (no Console desde a etapa G; a H não mudou regras).
// Mudança única: em campanhas/{cid}/pedidos, quem JÁ É JOGADOR da campanha pode mandar um
// pedido sem convite, marcado com membro: true, para levar mais uma ficha (o mestre aprova).
// Todo o resto é igual à etapa G.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    // Conta do Marco: autorizou a migração única e, enquanto o site é privado,
    // é a única que cria campanhas novas.
    function contaCriadora() {
      return logado()
        && request.auth.token.email == 'marcoa.barreto14@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function donoDe(dados) {
      return dados.get('donoUid', null) == request.auth.uid;
    }
    // Experiência (campos "xp" e, desde a etapa C, "xpInicial"): só o mestre dá.
    // O jogador nunca muda esses campos.
    function xpIntacta() {
      return request.resource.data.get('xp', null) == resource.data.get('xp', null)
        && request.resource.data.get('xpInicial', null) == resource.data.get('xpInicial', null);
    }

    // ======================================================================
    // COLEÇÕES ANTIGAS DA RAIZ (antes das campanhas). A migração para a
    // campanha Pangea já foi confirmada (etapa A, 08/10/2026): ficam guardadas,
    // só para leitura da conta do Marco, e ninguém grava mais nelas.
    // ======================================================================
    match /personagens/{id}     { allow read: if contaCriadora(); allow write: if false; }
    match /resumos/{id}         { allow read: if contaCriadora(); allow write: if false; }
    match /rolagens/{id}        { allow read: if contaCriadora(); allow write: if false; }
    match /rolagensNpc/{id}     { allow read: if contaCriadora(); allow write: if false; }
    match /itensPool/{id}       { allow read: if contaCriadora(); allow write: if false; }
    match /encontros/{id}       { allow read: if contaCriadora(); allow write: if false; }
    match /encontrosMesa/{id}   { allow read: if contaCriadora(); allow write: if false; }
    match /documentos/{id}      { allow read: if contaCriadora(); allow write: if false; }
    match /documentosNotas/{id} { allow read: if contaCriadora(); allow write: if false; }
    match /meta/{id}            { allow read: if contaCriadora(); allow write: if false; }

    // ======================================================================
    // CAMPANHAS. Tudo da mesa mora em campanhas/{cid}/...
    // O mestre é o dono da campanha (donoUid); jogadores estão em "membros".
    // ======================================================================
    function campanha(cid) {
      return get(/databases/$(database)/documents/campanhas/$(cid)).data;
    }
    function mestreDe(cid) {
      return logado() && campanha(cid).donoUid == request.auth.uid;
    }
    function membroDe(cid) {
      return logado() && (campanha(cid).donoUid == request.auth.uid || request.auth.uid in campanha(cid).get('membros', []));
    }
    // Etapa C: a Experiência inicial ("xpInicial") é regra da campanha. Ficha nova do
    // jogador só pode nascer sem ela ou com o valor configurado pelo mestre (7 se a
    // campanha ainda não tem a configuração salva).
    function xpInicialDaCampanha(cid) {
      return request.resource.data.get('xpInicial', null) == null
        || request.resource.data.xpInicial == campanha(cid).get('config', {}).get('criacao', {}).get('valores', {}).get('xpInicial', 7);
    }

    match /campanhas/{cid} {
      // Ler: membros. Um documento que ainda não existe pode ser consultado (tela de migração).
      allow get: if logado() && (resource == null || resource.data.donoUid == request.auth.uid
                                 || request.auth.uid in resource.data.get('membros', []));
      // Listar: só as campanhas em que a conta está (tela inicial: membros contém a conta).
      allow list: if logado() && request.auth.uid in resource.data.membros;
      // Criar: a conta criadora, que vira o dono e está na própria lista de membros.
      allow create: if contaCriadora()
        && request.resource.data.donoUid == request.auth.uid
        && request.auth.uid in request.resource.data.get('membros', []);
      allow update: if
        // o dono altera (inclusive a configuração, etapa C) e não passa a campanha pra outra conta
        (logado() && resource.data.donoUid == request.auth.uid
          && request.resource.data.donoUid == request.auth.uid)
        // um jogador sai sozinho: só tira a própria conta de "membros"
        || (logado() && resource.data.donoUid != request.auth.uid
          && request.auth.uid in resource.data.get('membros', [])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros'])
          && request.resource.data.membros.toSet() == resource.data.membros.toSet().difference([request.auth.uid].toSet()));
      allow delete: if logado() && resource.data.donoUid == request.auth.uid;

      // Fichas-cópia da campanha (o site ainda as chama de "personagens").
      // Etapa G: saiu o "vínculo pela senha" (ficha sem dono pega pelo jogador).
      // Quem dá uma ficha da mesa a um jogador agora é o mestre (update do mestre).
      match /fichas/{id} {
        allow read: if mestreDe(cid) || (membroDe(cid) && donoDe(resource.data));
        allow create: if mestreDe(cid)
          || (membroDe(cid) && donoDe(request.resource.data) && request.resource.data.get('xp', null) == null
              && xpInicialDaCampanha(cid));
        allow update: if mestreDe(cid)
          || (membroDe(cid) && donoDe(resource.data) && donoDe(request.resource.data) && xpIntacta());
        allow delete: if mestreDe(cid) || (membroDe(cid) && donoDe(resource.data));
      }
      match /resumos/{id} {
        allow read: if mestreDe(cid) || (membroDe(cid) && resource.data.ehNpc == false);
        allow create, update: if mestreDe(cid)
          || (membroDe(cid) && getAfter(/databases/$(database)/documents/campanhas/$(cid)/fichas/$(id)).data.get('donoUid', null) == request.auth.uid);
        allow delete: if mestreDe(cid)
          || (membroDe(cid) && get(/databases/$(database)/documents/campanhas/$(cid)/fichas/$(id)).data.get('donoUid', null) == request.auth.uid);
      }
      match /rolagens/{id} {
        allow read, create: if membroDe(cid);
        allow delete: if mestreDe(cid);
      }
      match /rolagensNpc/{id} {
        allow create: if membroDe(cid);
        allow read, delete: if mestreDe(cid);
      }
      match /documentos/{id} {
        allow read: if mestreDe(cid) || (membroDe(cid) && request.auth.uid in resource.data.get('leitores', []));
        allow write: if mestreDe(cid);
      }
      match /encontrosMesa/{id} {
        allow read: if membroDe(cid);
        allow write: if mestreDe(cid);
      }
      match /meta/{id} {
        allow read: if membroDe(cid);
        allow write: if mestreDe(cid);
      }
      // Só o mestre: notas dos documentos, criaturas com estado completo, itens achados,
      // notas do mestre e locais.
      match /documentosNotas/{id} { allow read, write: if mestreDe(cid); }
      match /encontros/{id}       { allow read, write: if mestreDe(cid); }
      match /itensPool/{id}       { allow read, write: if mestreDe(cid); }
      match /notas/{id}           { allow read, write: if mestreDe(cid); }
      match /locais/{id}          { allow read, write: if mestreDe(cid); }
      // Etapa D: catálogo de criaturas da campanha (só o mestre).
      match /criaturas/{id}       { allow read, write: if mestreDe(cid); }

      // Convites (etapa B): quem tem o link (o código) consegue ler aquele convite;
      // só o mestre lista, cria e apaga (apagar = desativar o link).
      match /convites/{codigo} {
        allow get: if logado();
        allow list, write: if mestreDe(cid);
      }
      // Pedidos: o documento tem o id da conta que pede. O mestre vê, recusa ou aprova (e apaga).
      //  - quem ainda não está na campanha: só com um convite ativo desta campanha;
      //  - etapa H2: quem já é jogador (está em "membros" e não é o mestre) pede sem
      //    convite, com membro: true, para levar mais uma ficha.
      function conviteAtivo(codigo) {
        return get(/databases/$(database)/documents/campanhas/$(cid)/convites/$(codigo)).data.get('ativo', false) == true;
      }
      match /pedidos/{uidP} {
        allow get: if logado() && (uidP == request.auth.uid || mestreDe(cid));
        allow list: if mestreDe(cid);
        allow create, update: if (logado() && uidP == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'pendente'
            && request.resource.data.get('membro', false) == true
            && campanha(cid).donoUid != request.auth.uid
            && request.auth.uid in campanha(cid).get('membros', []))
          || (logado() && uidP == request.auth.uid
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.status == 'pendente'
            && conviteAtivo(request.resource.data.codigo))
          || (mestreDe(cid) && resource != null && request.resource.data.uid == resource.data.uid);
        allow delete: if logado() && (uidP == request.auth.uid || mestreDe(cid));
      }
    }

    // Fichas-base: a ficha do jogador na conta dele, fora de qualquer campanha.
    match /fichas/{id} {
      allow read, delete: if logado() && donoDe(resource.data);
      allow update: if logado() && donoDe(resource.data) && donoDe(request.resource.data);
      allow create: if logado() && (
        // o próprio jogador cria a sua
        donoDe(request.resource.data)
        // ou o mestre gera a base a partir da cópia que está na campanha dele
        || (mestreDe(request.resource.data.origemCampanha)
            && getAfter(/databases/$(database)/documents/campanhas/$(request.resource.data.origemCampanha)/fichas/$(id)).data.get('donoUid', null) == request.resource.data.donoUid)
        // Etapa G: o mestre passa uma ficha da campanha (NPC ou sem conta) para um
        // jogador que está na campanha. A base nasce com id novo e "copiaId" = id da
        // ficha da campanha, que no mesmo lote fica com esse dono e com baseId = esta base.
        || (mestreDe(request.resource.data.origemCampanha)
            && request.resource.data.get('copiaId', null) is string
            && request.resource.data.get('donoUid', null) is string
            && request.resource.data.donoUid != request.auth.uid
            && request.resource.data.donoUid in campanha(request.resource.data.origemCampanha).get('membros', [])
            && getAfter(/databases/$(database)/documents/campanhas/$(request.resource.data.origemCampanha)/fichas/$(request.resource.data.copiaId)).data.get('donoUid', null) == request.resource.data.donoUid
            && getAfter(/databases/$(database)/documents/campanhas/$(request.resource.data.origemCampanha)/fichas/$(request.resource.data.copiaId)).data.get('baseId', null) == id)
      );

      // Fichas guardadas (etapa B): a cópia de uma campanha que a ficha deixou.
      // O dono da base mexe à vontade. O mestre da campanha de onde ela saiu pode
      // guardá-la ao remover o jogador, ler e apagar ao aprovar a volta.
      function donoDaBase() {
        return getAfter(/databases/$(database)/documents/fichas/$(id)).data.get('donoUid', null);
      }
      match /guardadas/{gid} {
        allow read, write: if logado() && get(/databases/$(database)/documents/fichas/$(id)).data.get('donoUid', null) == request.auth.uid;
        allow create: if logado() && donoDaBase() == request.auth.uid;
        allow get, delete: if logado() && mestreDe(resource.data.campanhaId);
        allow create, update: if logado() && mestreDe(request.resource.data.campanhaId)
          && request.resource.data.get('donoUid', null) == donoDaBase()
          && request.resource.data.get('id', null) == gid
          && (get(/databases/$(database)/documents/campanhas/$(request.resource.data.campanhaId)/fichas/$(gid)).data.get('baseId', null) == id
              || (get(/databases/$(database)/documents/campanhas/$(request.resource.data.campanhaId)/fichas/$(gid)).data.get('baseId', null) == null && gid == id));
      }
    }
  }
}
